```
aim@aim-PowerEdge-T620:~$ cd /media/aim/data/oxide-sim/omicron

aim@aim-PowerEdge-T620:/media/aim/data/oxide-sim/omicron$ source env.sh

aim@aim-PowerEdge-T620:/media/aim/data/oxide-sim/omicron$ !1684
cargo xtask omicron-dev run-all

```

