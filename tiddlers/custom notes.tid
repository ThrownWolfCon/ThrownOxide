  text-shadow: 0 0 6px #ff4444;
}

/* ==================== SHARED ICON STYLING ==================== */
.custom-note .alert-icon,
.custom-info .alert-icon,
.custom-tip .alert-icon,
.custom-important .alert-icon,
.custom-warning .alert-icon {
  display: inline-block;
  width: 20px;
  height: 20px;
  background-color: inherit;
  color: white;
  border-radius: 50%;
  text-align: center;
  line-height: 20px;
  font-weight: bold;
  font-size: 14px;
  margin-right: 10px;
  vertical-align: middle;
  border: 1px solid currentColor;
}