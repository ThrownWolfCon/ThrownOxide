/* ==================== NOTE - GREEN ==================== */
.custom-note {
  background-color: #0a3d2a;
  color: #b3f0d0;
  border: 1px solid #1a7c5d;
  border-radius: 6px;
  padding: 12px 16px;
  margin: 1em 0;
  font-size: 14px;
  line-height: 1.5;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

.custom-note strong {
  color: #00ff9d;
  text-shadow: 0 0 6px #00ff9d;
}

/* ==================== INFO - BLUE ==================== */
.custom-info {
  background-color: #0a2a3d;
  color: #b3e0f0;
  border: 1px solid #1a5c7c;
  border-radius: 6px;
  padding: 12px 16px;
  margin: 1em 0;
  font-size: 14px;
  line-height: 1.5;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

.custom-info strong {
  color: #00d4ff;
  text-shadow: 0 0 6px #00d4ff;
}

/* ==================== TIP - PURPLE ==================== */
