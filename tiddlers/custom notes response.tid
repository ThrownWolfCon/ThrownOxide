/* ==================== SHARED ICON STYLING ==================== */
.custom-note .alert-icon,
.custom-info .alert-icon,
.custom-tip .alert-icon,
.custom-important .alert-icon,
.custom-warning .alert-icon,
.custom-note-response .alert-icon,
.custom-info-response .alert-icon,
.custom-tip-response .alert-icon,
.custom-important-response .alert-icon,
.custom-warning-response .alert-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  font-size: 13px;
  line-height: 1;
  margin-right: 10px;
  vertical-align: middle;
  border-radius: 50%;
  border: 1px solid currentColor;
  flex-shrink: 0;
}