/* ==================== NOTE RESPONSE - LIGHTER GREEN ==================== */
.custom-note-response {
  background-color: #1a5c45;
  color: #b3f0d0;
  border: 1px solid #25a070;
  border-radius: 6px;
  padding: 12px 16px;
  margin: 1em 0;
  font-size: 14px;
  line-height: 1.5;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}
.custom-note-response strong {
  color: #00ff9d;
  text-shadow: 0 0 0px #00ff9d;
}

