{
  "name": "$siloName",
  "description": "$siloDescription",
  "discoverable": true,
  "identity_mode": "saml_jit",
  "admin_group_name": "$idpAdminGroup",
  "mapped_fleet_roles": {
    "admin": [
      "admin"
    ]
  },
  "quotas": {
    "cpus": 18,
    "memory": 8589934592,
    "storage": 107374182400
  },
  "tls_certificates": [{
    "name": "initial-install-cert",
