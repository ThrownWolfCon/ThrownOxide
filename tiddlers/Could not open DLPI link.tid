michael@warhound:~$ ipadm show-addr
ADDROBJ           TYPE     STATE        ADDR
lo0/v4            static   ok           127.0.0.1/8
bge0/dhcp         dhcp     ok           192.168.1.28/24
bge1/dhcp         dhcp     ok           192.168.1.29/24
lo0/v6            static   ok           ::1/128
